              {
                "id": "1c2c5f50-1b96-4342-8fc9-c3d93340c82e",
                "type": "text",
                "styleId": "text-default",
                "style": {
                  "padding": "0",
                  "margin": "0"
                },
                "content": "<p><span style=\"font-family: 思源黑体; color: rgb(13, 13, 13); font-weight: bold; font-size: 11pt;\"><strong>开发语言：</strong></span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>Java</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">、</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>SQL</strong></span></p><p style=\"text-align: left;\"><span style=\"font-family: 思源黑体; color: rgb(13, 13, 13); font-weight: bold; font-size: 11pt;\"><strong>开发环境：</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 11pt;\">IntelliJ IDEA、JDK、</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 11pt;\"><strong>MySQL</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 11pt;\">、Swing、</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 11pt;\"><strong>JDBC</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 11pt;\">、</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 11pt;\"><strong>SQLyog</strong></span></p><p style=\"text-align: left;\"><span style=\"font-family: 思源黑体; color: rgb(13, 13, 13); font-weight: bold; font-size: 11pt;\"><strong>开发内容：</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">完成</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>后端</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">逻辑与</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>数据库设计</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">，实现管理员仪表板、用户管理、猫咪管理、</span></p><p style=\"text-align: left;\"><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">&nbsp;&nbsp;&nbsp;&nbsp; 领养申请审核、操作日志等功能；设计7张关系表，利用</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>外键</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">与</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>事务</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">确保领养审核</span></p><p style=\"text-align: left;\"><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">&nbsp;&nbsp;&nbsp;&nbsp; 时</span><span style=\"font-family: &quot;思源黑体 Bold&quot;; color: rgb(38, 38, 38); font-weight: bold; font-size: 10.5pt;\"><strong>数据一致性</strong></span><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">；编写复杂SQL完成数据统计（总数、待处理、新增等），实现操作</span></p><p style=\"text-align: left;\"><span style=\"font-family: 思源黑体; color: rgb(38, 38, 38); font-size: 10.5pt;\">&nbsp;&nbsp;&nbsp;&nbsp; 日志自动记录与导出</span></p>",
